aws_region             = "us-east-1"
environment            = "dev"
project_name           = "inference-deployment"
vpc_cidr               = "10.0.0.0/16"
public_subnet_cidr     = "10.0.1.0/24"
private_subnet_cidr    = "10.0.2.0/24"
api_gateway_instance_type = "t3.small"
inference_instance_type   = "t3.small"
enable_bastion         = true

# IMPORTANT: Restrict SSH access to your IP in production
# Change this to your IP address (e.g., "203.0.113.45/32")
allowed_ssh_cidrs      = ["0.0.0.0/0"]

# API can be accessed from anywhere by default
allowed_api_cidrs      = ["0.0.0.0/0"]
